[resource]
script = ExtResource("1_tech")
id = &"pln_assault_doctrine"
display_name = "Surface operations"
field = 2
tier = 2
cost_credits = 900
cost_iron = 120
cost_titanium = 60
research_time = 220.0
prerequisites = Array[StringName]([&"pln_orbital_survey"])

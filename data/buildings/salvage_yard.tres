[resource]
script = ExtResource("1_bdef")
id = &"salvage_yard"
display_name = "Salvage Yard"
short_label = "Salvage Yard"
description = "Scrap yard run as a small business. Salvagers hired here strip wrecks on their own, no contract needed; the yard pays them per load, reprocesses the scrap into iron, titanium and a little crystal, and sells it to you below the Factory's price. Now and then a load holds a rare part."
model_path = "res://assets/models/buildings/salvage_yard.glb"
cost_credits = 500
cost_iron = 80
cost_titanium = 20
build_time = 20.0
footprint_radius = 35.0
structure_hull = 1600.0
placeholder_tint = Color(1, 0.55, 0.22, 1)
max_hires = 3
hire_cost_credits = 250
hire_role = "Salvager"
hire_ship_path = "res://assets/models/ships/salvager.glb"
hire_ship_script = ExtResource("2_salv")
max_shuttles = 3
shuttle_capacity = 60
ship_cost = 450
service_script = ExtResource("3_yard")
